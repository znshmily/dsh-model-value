{
  "name": "dsh-model-value",
  "version": "0.5.12",
  "private": false,
  "description": "按单价 × 智力给当前接入的每个模型排名（总榜 + 按提供方分组），并列出市面未接入模型的性价比，在输入框模型菜单里直接推荐与切换。Rank models connected to DeepSeek Harness by unit price, intelligence and value for money.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model",
    "pricing",
    "intelligence",
    "value",
    "ranking"
  ],
  "homepage": "https://github.com/znshmily/dsh-model-value#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znshmily/dsh-model-value.git"
  },
  "bugs": {
    "url": "https://github.com/znshmily/dsh-model-value/issues"
  },
  "author": "znshmily",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "vendor",
    "data",
    "locale",
    "docs",
    "tools",
    "test",
    "assets",
    "screenshots.json",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/",
    "check": "node --check index.js && node --check client.js",
    "sync": "node tools/sync-sources.mjs"
  }
}
